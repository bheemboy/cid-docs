{
  // This file is not used in compilation. It is here just for a nice editor experience.
  // Inlined from @docusaurus/tsconfig minus the deprecated baseUrl/paths
  // (no @site/* aliases are used in this project; if that changes, restore the extend).
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "skipLibCheck": true
  },
  "exclude": [".docusaurus", "build"]
}
